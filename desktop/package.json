{
  "name": "recap-desktop",
  "productName": "Recap",
  "version": "0.2.1",
  "description": "Recap screen recorder for Windows and Linux",
  "author": "Aditya",
  "homepage": "https://github.com/Aditya-galaxy/recap",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "engine": "node scripts/prepare-engine.mjs"
  },
  "build": {
    "appId": "dev.recap.desktop",
    "productName": "Recap",
    "files": [
      "main.js",
      "engine.js",
      "preload.js",
      "library-preload.js",
      "ui/**",
      "build/tray*.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "Aditya <noreply@github.com>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSCameraUsageDescription": "Recap shows your camera in a floating bubble that's recorded with your screen.",
        "NSMicrophoneUsageDescription": "Recap records your voice with your screen."
      }
    },
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
