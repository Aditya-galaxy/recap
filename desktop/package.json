{
  "name": "recap-desktop",
  "productName": "Recap",
  "version": "0.3.2",
  "description": "Recap screen recorder for Windows and Linux",
  "author": "Aditya",
  "homepage": "https://github.com/Aditya-galaxy/recap",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "engine": "node scripts/prepare-engine.mjs",
    "bins": "node scripts/fetch-ffmpeg.mjs && node scripts/build-whisper.mjs"
  },
  "build": {
    "appId": "dev.recap.desktop",
    "productName": "Recap",
    "files": [
      "main.js",
      "engine.js",
      "preload.js",
      "library-preload.js",
      "ui/**",
      "build/tray*.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Recap-windows-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Recap-windows-x64-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "Aditya <noreply@github.com>",
      "artifactName": "Recap-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSCameraUsageDescription": "Recap shows your camera in a floating bubble that's recorded with your screen.",
        "NSMicrophoneUsageDescription": "Recap records your voice with your screen.",
        "LSMinimumSystemVersion": "13.0"
      },
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "artifactName": "Recap-mac-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
