{
  "name": "recap-desktop",
  "productName": "Recap",
  "version": "0.1.0",
  "description": "Recap screen recorder for Windows and Linux",
  "author": "Aditya",
  "homepage": "https://github.com/Aditya-galaxy/recap",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "dev.recap.desktop",
    "productName": "Recap",
    "files": [
      "main.js",
      "preload.js",
      "ui/**",
      "build/tray*.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "Aditya <noreply@github.com>"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
