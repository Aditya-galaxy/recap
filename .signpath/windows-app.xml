<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "windows-app": the whole Windows app folder (electron-builder's win-unpacked,
     uploaded by CI as a zip). Signs every program and library in it: Recap.exe, elevate.exe, the bundled
     ffmpeg/whisper-cli/llama-completion, Electron's DLLs and native modules. Smart App Control checks each one as it
     loads. Measured on v0.6.0: everything was unsigned except two Microsoft DLLs, excluded below. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="**/*.exe" max-matches="unbounded" />
      <include path="**/*.dll" max-matches="unbounded" />
      <include path="**/*.node" max-matches="unbounded" />
      <!-- Already signed by Microsoft (shipped with Electron): leave their signatures alone. -->
      <exclude path="d3dcompiler_47.dll" />
      <exclude path="dxil.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
